    {
      "name": "Auth - Sign Up Tests",
      "item": [
        {
          "name": "1. Sign Up - SCHOOL_ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"admin_user_id\", jsonData.user_id);",
                  "    pm.environment.set(\"admin_email\", jsonData.email);",
                  "    pm.environment.set(\"admin_verification_token\", jsonData.verification_token);",
                  "    console.log(\"✅ SCHOOL_ADMIN Sign Up Success\");",
                  "    console.log(\"User ID: \" + jsonData.user_id);",
                  "} else {",
                  "    console.log(\"❌ Sign Up Failed: \" + pm.response.code);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"schooladmin{{$timestamp}}@example.com\",\"password\":\"SecurePassword123\",\"first_name\":\"Admin\",\"last_name\":\"User\",\"phone_number\":\"+1{{$randomInt}}\",\"role\":\"SCHOOL_ADMIN\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/sign-up",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "sign-up"]
            },
            "description": "Sign up as SCHOOL_ADMIN - can create their own school"
