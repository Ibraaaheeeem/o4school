          ]
        }
      }
    },
    {
      "name": "9. Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"user_id\":\"{{user_id}}\"}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/logout",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "auth",
            "logout"
          ]
        }
      }
    }
  ],
  "variable": [
