    {
      "name": "7. Forgot Password",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    console.log('✅ Password Reset Email Sent');",
              "} else {",
              "    console.log('❌ Forgot Password Failed: ' + pm.response.code);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
