          ]
        }
      }
    },
    {
      "name": "8. Reset Password (Manual Entry)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{email}}\",\"reset_token\":\"token-here\",\"new_password\":\"NewPassword123!\",\"confirm_password\":\"NewPassword123!\"}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/reset-password",
          "protocol": "http",
          "host": [
            "localhost"
          ],
