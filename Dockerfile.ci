# Triggering fresh build with proven stable configuration
FROM ghcr.io/graalvm/native-image-community:21-muslib AS builder

# Install build essentials and dependencies
# We need findutils for xargs which gradlew uses
RUN microdnf install -y findutils tar gzip gcc zlib-devel glibc-static
ENV CI=true

WORKDIR /app

# Cache dependencies
COPY gradle gradle
COPY gradlew .
COPY build.gradle .
COPY settings.gradle .
COPY gradle.properties .

# Fix gradle.properties for CI environment
# 1. Remove hardcoded java.home and memory-heavy settings
RUN sed -i '/org.gradle.java.home/d' gradle.properties && \
    sed -i '/org.gradle.jvmargs/d' gradle.properties && \
    sed -i '/kotlin.daemon.jvmargs/d' gradle.properties && \
    sed -i '/org.gradle.parallel/d' gradle.properties && \
    sed -i '/org.gradle.configuration-cache/d' gradle.properties && \
    sed -i '/org.gradle.caching/d' gradle.properties
# 2. Ensure distributionUrl points to the official URL
RUN sed -i 's|distributionUrl=.*|distributionUrl=https://services.gradle.org/distributions/gradle-8.10.2-bin.zip|' gradle/wrapper/gradle-wrapper.properties

RUN chmod +x gradlew
RUN ./gradlew dependencies -x test --no-daemon --no-configuration-cache

# Build native image
COPY . .

# Apply the same fixes again after copying full source (as it overwrites the previous files)
RUN sed -i '/org.gradle.java.home/d' gradle.properties && \
    sed -i '/org.gradle.jvmargs/d' gradle.properties && \
    sed -i '/kotlin.daemon.jvmargs/d' gradle.properties && \
    sed -i '/org.gradle.parallel/d' gradle.properties && \
    sed -i '/org.gradle.configuration-cache/d' gradle.properties && \
    sed -i '/org.gradle.caching/d' gradle.properties
RUN sed -i 's|distributionUrl=.*|distributionUrl=https://services.gradle.org/distributions/gradle-8.10.2-bin.zip|' gradle/wrapper/gradle-wrapper.properties

RUN ./gradlew nativeCompile -x test --no-daemon --info --no-configuration-cache -Dorg.gradle.jvmargs=-Xmx2G -Dkotlin.daemon.jvmargs=-Xmx2G

FROM debian:12-slim
WORKDIR /app
# Install runtime dependencies (zlib)
RUN apt-get update && apt-get install -y zlib1g && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/build/native/nativeCompile/4school /app/4school
EXPOSE 8080
ENTRYPOINT ["/app/4school"]