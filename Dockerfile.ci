# Stage 1: Build
FROM ghcr.io/graalvm/native-image-community:21 AS builder

RUN microdnf install -y findutils tar gzip zlib-devel && \
    microdnf clean all

ENV CI=true
WORKDIR /app

COPY . .

# Fix properties and wrapper URL (Crucial for GitHub Actions)
RUN sed -i 's|distributionUrl=.*|distributionUrl=https://services.gradle.org/distributions/gradle-8.10.2-bin.zip|' gradle/wrapper/gradle-wrapper.properties && \
    sed -i '/org.gradle.java.home/d; /org.gradle.jvmargs/d; /kotlin.daemon.jvmargs/d; /org.gradle.parallel/d; /org.gradle.configuration-cache/d; /org.gradle.caching/d' gradle.properties && \
    chmod +x gradlew

# Build with comprehensive runtime initialization
# Build the native binary with explicit class-level runtime initialization
RUN ./gradlew nativeCompile -x test --no-daemon --info --no-configuration-cache \
    -Dorg.gradle.jvmargs=-Xmx3G \
    -Dkotlin.daemon.jvmargs=-Xmx2G \
    -PnativeImageArgs="--no-fallback \
    --initialize-at-run-time=okhttp3.internal.http.RetryAndFollowUpInterceptor\$Companion \
    --initialize-at-run-time=okhttp3.internal.http.RetryAndFollowUpInterceptor \
    --initialize-at-run-time=okhttp3.OkHttpClient \
    --initialize-at-run-time=okhttp3.internal.concurrent.TaskRunner\$Companion \
    --initialize-at-run-time=okhttp3.internal.concurrent.TaskRunner \
    --initialize-at-build-time=org.slf4j"

# Stage 2: Runtime
FROM debian:12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends zlib1g && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/build/native/nativeCompile/4school /app/4school

EXPOSE 8080
ENTRYPOINT ["/app/4school"]