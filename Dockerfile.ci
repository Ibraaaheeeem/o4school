# Stage 1: Build (GraalVM Native Image)
FROM ghcr.io/graalvm/native-image-community:21 AS builder

# 1. Optimized install: Avoiding the glibc-static conflict
# We avoid installing 'gcc' directly because it triggers the glibc-devel conflict.
# The native-image image usually has the necessary binutils.
RUN microdnf install -y findutils tar gzip zlib-devel && \
    microdnf clean all

ENV CI=true
WORKDIR /app

# 2. Cache Gradle Wrapper
COPY gradle/ gradle/
COPY gradlew .
COPY build.gradle .
COPY settings.gradle .
COPY gradle.properties .

# 3. Apply CI-specific fixes
RUN sed -i '/org.gradle.java.home/d; /org.gradle.jvmargs/d; /kotlin.daemon.jvmargs/d; /org.gradle.parallel/d; /org.gradle.configuration-cache/d; /org.gradle.caching/d' gradle.properties && \
    sed -i 's|distributionUrl=.*|distributionUrl=https://services.gradle.org/distributions/gradle-8.10.2-bin.zip|' gradle/wrapper/gradle-wrapper.properties && \
    chmod +x gradlew

# Pre-download dependencies
RUN ./gradlew dependencies --no-daemon --no-configuration-cache

# 4. Copy Source and Build
COPY . .

# Build the native binary
# We added --no-fallback to ensure we get a real native executable
RUN ./gradlew nativeCompile -x test --no-daemon --info --no-configuration-cache \
    -Dorg.gradle.jvmargs=-Xmx2G \
    -Dkotlin.daemon.jvmargs=-Xmx2G \
    -PnativeImageArgs="--no-fallback"

# Stage 2: Tiny Runtime Image
FROM debian:12-slim
WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends zlib1g && \
    rm -rf /var/lib/apt/lists/*

# Final Binary Copy
COPY --from=builder /app/build/native/nativeCompile/4school /app/4school

EXPOSE 8080
ENTRYPOINT ["/app/4school"]
