# Stage 1: Build the native image
FROM ghcr.io/graalvm/native-image-community:21 AS builder

# 1. Install dependencies (Removed --allowerasing and --best as they are unsupported)
RUN microdnf install -y findutils tar gzip gcc zlib-devel && \
    microdnf clean all

ENV CI=true
WORKDIR /app

# 2. Cache Gradle Wrapper and Dependencies
# This layer only rebuilds if you change your gradle files
COPY gradle/ gradle/
COPY gradlew .
COPY build.gradle .
COPY settings.gradle .
COPY gradle.properties .

# 3. Clean up properties for CI (Only needs to be done once here)
RUN sed -i '/org.gradle.java.home/d; /org.gradle.jvmargs/d; /kotlin.daemon.jvmargs/d; /org.gradle.parallel/d; /org.gradle.configuration-cache/d; /org.gradle.caching/d' gradle.properties && \
    sed -i 's|distributionUrl=.*|distributionUrl=https://services.gradle.org/distributions/gradle-8.10.2-bin.zip|' gradle/wrapper/gradle-wrapper.properties && \
    chmod +x gradlew

# Pre-download dependencies to speed up subsequent builds
RUN ./gradlew dependencies --no-daemon --no-configuration-cache

# 4. Copy source code and build
COPY . .

# Run the build (The nativeCompile task)
# Optimized nativeCompile with resource constraints for CI
RUN ./gradlew nativeCompile -x test --no-daemon --info --no-configuration-cache \
    -Dorg.gradle.jvmargs=-Xmx2G \
    -Dkotlin.daemon.jvmargs=-Xmx2G \
    -PnativeImageArgs="--no-fallback --gc=serial -O3 --static"
    
# Stage 2: Final Runtime Image
FROM debian:12-slim
WORKDIR /app

# Install runtime dependencies (zlib is required for the native binary)
RUN apt-get update && \
    apt-get install -y --no-install-recommends zlib1g && \
    rm -rf /var/lib/apt/lists/*

# Copy the binary from the builder stage
# Note: Ensure the path /app/build/native/nativeCompile/4school matches your project structure
COPY --from=builder /app/build/native/nativeCompile/4school /app/4school

EXPOSE 8080
ENTRYPOINT ["/app/4school"]