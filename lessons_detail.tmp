                                                                                                                                                              worked_examples                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |                                                                                                                                                                                             stop_think_checks                                                                                                                                                                                              |                                                                                                                                                                    reflection_prompts                                                                                                                                                                     |                                                                                                                                                                                                                                                                                                                                                                                                                                                                  introduction                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             lesson_content                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              | subject_specific_content |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 hook_introduction_teacher_notes                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               introduction_teacher_notes                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          learning_objectives_teacher_notes                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                lesson_content_teacher_notes                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |                                                                                                                                                                                                                                                                                                                                                                                                           key_concepts_teacher_notes                                                                                                                                                                                                                                                                                                                                                                                                           |                                                                                                                                                                                                                                                                                                     real_life_scenarios_teacher_notes                                                                                                                                                                                                                                                                                                      |                                                                                                                                                                                                                                                                                                                                                                                                              practical_activities_teacher_notes                                                                                                                                                                                                                                                                                                                                                                                                              |                                                                                                                                                                                                                                                                                     worked_examples_teacher_notes                                                                                                                                                                                                                                                                                      |                                                                                                                                                                                                                                               stop_think_checks_teacher_notes                                                                                                                                                                                                                                                |                                                                                                                                                                                                                                                                                                                                                                      assessment_questions_teacher_notes                                                                                                                                                                                                                                                                                                                                                                       |                                                                                                                                                                                                                                                  homework_assignments_teacher_notes                                                                                                                                                                                                                                                  |                                                                                                                                                           reflection_prompts_teacher_notes                                                                                                                                                           |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               student_study_notes        